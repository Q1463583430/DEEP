# ========================
# 1. 忽略 Python 生成的缓存文件
# ========================
__pycache__/
*.py[cod]
*$py.class

# ========================
# 2. 忽略 Jupyter Notebook 运行缓存
# ========================
.ipynb_checkpoints

# ========================
# 3. 忽略虚拟环境 (如果你用了的话)
# ========================
venv/
env/
.env/

# ========================
# 4. 忽略本地 IDE/编辑器的配置信息
# ========================
.vscode/
.idea/
